__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/
# Real data products are large and externally sourced: manifests and metadata
# are tracked, the bulk products are not.
data/raw/**
data/processed/**
!data/**/.gitkeep
!data/**/README.md

# Raw byte caches of archive products (REAL-DATA-01). These are re-fetchable from
# PDS by the byte range recorded in data/manifests/, and their SHA-256 is already
# tracked there, so the bytes themselves are cache and not evidence.
# Everything else under experiments/REAL-DATA/ -- metrics JSON, diagnostic figures,
# the hypothesis grid -- IS tracked.
experiments/**/*.raw

# setuptools editable-install metadata (pip install -e .)
src/*.egg-info/

# Real archive products fetched by hand (Chandrayaan-2 and similar bulk data).
# Multi-gigabyte and externally sourced: the manifests and labels are tracked,
# the bulk products are not. Without this a broad `git add` attempts ~23 GB.
data/realdata/**
data/realdata.zip
# Re-include the PDS4 labels: they are small, they are the evidence the
# readiness report is built from, and git cannot re-include a file whose
# parent directory is excluded -- hence the directory negation first.
!data/realdata/**/
!data/realdata/**/*.xml
!data/realdata/**/readme.txt
